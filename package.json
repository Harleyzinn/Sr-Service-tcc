{
  "name": "sr-service",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-sr-service \"node --test --test-concurrency=1 tests/firestore.rules.test.mjs tests/chat.rules.test.mjs tests/legacy.rules.test.mjs\"",
    "test:firebase": "firebase emulators:exec --only auth,firestore --project demo-sr-service \"playwright test --config playwright.firebase.config.js\""
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "firebase": "^13.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.51.0",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.1",
    "prettier": "^3.9.10",
    "vite": "^6.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
