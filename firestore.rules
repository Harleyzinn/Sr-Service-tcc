rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function admin() { return verified() && request.auth.token.get('admin', false) == true; }
    function text(value, min, max) { return value is string && value.size() >= min && value.size() <= max; }
    function status(value) { return value in ['Recebido','Em análise','Proposta enviada','Aprovado','Em execução','Concluído','Cancelado']; }
    function profile(data) {
      return data.keys().hasAll(['full_name','company','phone','document','address','email','created_at'])
        && data.keys().hasOnly(['full_name','company','phone','document','address','email','created_at'])
        && text(data.full_name,0,120) && text(data.company,0,160)
        && text(data.phone,0,20) && text(data.document,0,20) && text(data.address,0,500)
        && data.email == request.auth.token.email && data.created_at is timestamp;
    }
    match /profiles/{uid} {
      allow get: if signedIn() && (uid == request.auth.uid || admin());
      allow list: if admin();
      allow create: if signedIn() && uid == request.auth.uid && profile(request.resource.data)
        && request.resource.data.created_at == request.time;
      allow update: if signedIn() && uid == request.auth.uid && profile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['full_name','company','phone','document','address']);
      allow delete: if false;
    }
    function quote(data, id) {
      return data.keys().hasAll(['number','user_id','service','equipment','description','urgency','company','contact_name','email','phone','address','status','amount','notes','created_at','updated_at','events','last_event_id'])
        && data.keys().hasOnly(['number','user_id','service','equipment','description','urgency','company','contact_name','email','phone','address','status','amount','notes','created_at','updated_at','events','last_event_id'])
        && data.number == id && data.user_id is string
        && data['service'] in ['Manutenção preventiva e corretiva','Modernização de equipamentos','Inspeções e laudos técnicos','Montagem e instalação','Peças e componentes','Consultoria técnica']
        && text(data.equipment,1,200) && text(data.description,20,5000)
        && data.urgency in ['Planejado','O quanto antes','Apenas uma cotação']
        && text(data.company,1,160) && text(data.contact_name,1,120)
        && text(data.email,3,254) && data.email.matches('^[^ @]+@[^ @]+[.][^ @]+$')
        && text(data.phone,10,20) && data.phone.matches('^[(]?[0-9]{2}[)]?[ .-]?[0-9]{4,5}[- ]?[0-9]{4}$')
        && text(data.address,1,500) && status(data.status)
        && (data.amount == null || (data.amount is number && data.amount >= 0 && data.amount <= 999999999))
        && text(data.notes,0,5000) && data.created_at is timestamp && data.updated_at == request.time
        && data.events is map && text(data.last_event_id,1,128);
    }
    function latestEvent(data) {
      let event = data.events[data.last_event_id];
      return event is map && event.keys().hasAll(['status','created_at'])
        && event.keys().hasOnly(['status','created_at'])
        && event.status == data.status && event.created_at == request.time;
    }
    function history(data, old) {
      return (data.status == old.status && data.events == old.events && data.last_event_id == old.last_event_id)
        || (data.status != old.status
          && data.events.diff(old.events).addedKeys().hasOnly([data.last_event_id])
          && data.events.diff(old.events).addedKeys().size() == 1
          && data.events.diff(old.events).changedKeys().size() == 0
          && data.events.diff(old.events).removedKeys().size() == 0
          && latestEvent(data));
    }
    match /quotes/{id} {
      allow read: if verified() && (resource.data.user_id == request.auth.uid || admin());
      allow create: if verified() && quote(request.resource.data,id)
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.status == 'Recebido' && request.resource.data.amount == null && request.resource.data.notes == ''
        && request.resource.data.created_at == request.time
        && request.resource.data.last_event_id == 'received'
        && request.resource.data.events.keys().hasOnly(['received']) && latestEvent(request.resource.data);
      allow update: if admin() && quote(request.resource.data,id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','amount','notes','updated_at','events','last_event_id'])
        && history(request.resource.data,resource.data);
      allow delete: if false;
    }
    // One persistent support conversation per customer. Messages cannot be edited or removed.
    function chatAccess(uid) { return verified() && (request.auth.uid == uid || admin()); }
    function chatSender(uid, data) {
      return data.sender_id == request.auth.uid
        && ((data.sender_role == 'customer' && request.auth.uid == uid) || (data.sender_role == 'admin' && admin()));
    }
    function chatMessage(data, uid) {
      return data.keys().hasAll(['sender_id','sender_role','text','created_at'])
        && data.keys().hasOnly(['sender_id','sender_role','text','created_at'])
        && chatSender(uid,data) && text(data.text,1,4000)
        && data.text.matches('[\\s\\S]*[^\\s][\\s\\S]*') && data.created_at == request.time;
    }
    function chatRoom(data, uid) {
      return data.keys().hasAll(['customer_id','customer_name','customer_company','created_at','updated_at','last_message_id','last_text','last_sender_id','last_sender_role','message_count'])
        && data.keys().hasOnly(['customer_id','customer_name','customer_company','created_at','updated_at','last_message_id','last_text','last_sender_id','last_sender_role','message_count'])
        && data.customer_id == uid && text(data.customer_name,1,120) && text(data.customer_company,0,160)
        && data.created_at is timestamp && data.updated_at == request.time
        && data.last_message_id.matches('^[a-zA-Z0-9_-]{1,80}$') && text(data.last_text,1,4000)
        && data.message_count is int && data.message_count > 0 && data.message_count <= 1000000000;
    }
    function chatLatest(data, uid) {
      let path = /databases/$(database)/documents/conversations/$(uid)/messages/$(data.last_message_id);
      let message = getAfter(path).data;
      return !exists(path) && chatMessage(message,uid)
        && message.text == data.last_text && message.sender_id == data.last_sender_id && message.sender_role == data.last_sender_role;
    }
    match /conversations/{uid} {
      allow get: if chatAccess(uid);
      allow list: if admin();
      allow create: if verified() && request.auth.uid == uid && chatRoom(request.resource.data,uid)
        && request.resource.data.created_at == request.time && request.resource.data.message_count == 1
        && request.resource.data.last_sender_role == 'customer' && chatLatest(request.resource.data,uid);
      allow update: if chatAccess(uid) && chatRoom(request.resource.data,uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updated_at','last_message_id','last_text','last_sender_id','last_sender_role','message_count'])
        && request.resource.data.message_count == resource.data.message_count + 1 && chatLatest(request.resource.data,uid);
      allow delete: if false;
      match /messages/{id} {
        function linked() {
          let room = getAfter(/databases/$(database)/documents/conversations/$(uid)).data;
          return room.last_message_id == id && room.updated_at == request.time
            && room.last_text == request.resource.data.text && room.last_sender_id == request.auth.uid
            && room.last_sender_role == request.resource.data.sender_role;
        }
        allow read: if chatAccess(uid);
        allow create: if chatAccess(uid) && id.matches('^[a-zA-Z0-9_-]{1,80}$') && chatMessage(request.resource.data,uid) && linked();
        allow update, delete: if false;
      }
    }
    // Private finance. Customer-service administrators have no cross-user access.
    function own(uid) { return verified() && request.auth.uid == uid; }
    function money(value, minimum) { return value is int && value >= minimum && value <= 99999999999; }
    function dateString(value) {
      let parts = value.split('-');
      let year = int(parts[0]); let month = int(parts[1]); let day = int(parts[2]);
      return value.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && day <= (month == 2 ? (year % 4 == 0 ? 29 : 28) : (month in [4,6,9,11] ? 30 : 31));
    }
    function category(value) { return value in ['Serviços','Salário','Vendas','Alimentação','Transporte','Moradia','Equipamentos','Impostos','Assinaturas','Outros']; }
    function paidDate(value) {
      let parts = value.split('-');
      return timestamp.date(int(parts[0]),int(parts[1]),int(parts[2])) + duration.value(3,'h') <= request.time;
    }
    function metadata(data) { return data.version is int && data.created_at is timestamp && data.updated_at == request.time; }
    function initial(data) { return metadata(data) && data.version == 1 && data.created_at == request.time; }
    function nextVersion(data, old) { return metadata(data) && data.version == old.version + 1 && data.created_at == old.created_at; }
    function accountExists(uid,id) { return id is string && exists(/databases/$(database)/documents/users/$(uid)/accounts/$(id)); }
    function financeAccount(data) {
      return data.keys().hasAll(['name','type','opening_cents','version','created_at','updated_at']) && data.keys().hasOnly(['name','type','opening_cents','version','created_at','updated_at'])
        && text(data.name,1,80) && data.type in ['checking','cash','card'] && data.opening_cents is int && data.opening_cents >= -99999999999 && data.opening_cents <= 99999999999;
    }
    function financeEntry(data,uid) {
      return data.keys().hasAll(['kind','description','category','account_id','to_account_id','amount_cents','date','status','series_id','version','created_at','updated_at'])
        && data.keys().hasOnly(['kind','description','category','account_id','to_account_id','amount_cents','date','status','series_id','version','created_at','updated_at'])
        && data.kind in ['income','expense','transfer'] && text(data.description,3,160) && category(data.category) && money(data.amount_cents,1)
        && data.date is string && dateString(data.date) && data.status in ['paid','pending','void'] && (data.status != 'paid' || paidDate(data.date)) && accountExists(uid,data.account_id)
        && data.series_id is string && data.series_id.size() <= 160
        && (data.kind == 'transfer' ? (accountExists(uid,data.to_account_id) && data.to_account_id != data.account_id && data.series_id == '') : data.to_account_id == '');
    }
    function occurrence(data,uid,id) {
      let series = get(/databases/$(database)/documents/users/$(uid)/series/$(data.series_id)).data;
      return id == data.series_id + '_' + data.date && series.active == true
        && data.date >= series.start_date && (series.end_date == '' || data.date <= series.end_date)
        && data.kind == series.kind && data.account_id == series.account_id && data.amount_cents == series.amount_cents && data.category == series.category && data.description == series.description
        && recurrenceDate(data.date,series.start_date,series.frequency);
    }
    function recurrenceDate(value,start,frequency) {
      let v=value.split('-'); let s=start.split('-'); let y=int(v[0]); let m=int(v[1]); let d=int(v[2]); let sy=int(s[0]); let sm=int(s[1]); let sd=int(s[2]);
      let last=m == 2 ? (y % 4 == 0 ? 29 : 28) : (m in [4,6,9,11] ? 30 : 31);
      return frequency == 'weekly' ? ((timestamp.date(y,m,d).toMillis() - timestamp.date(sy,sm,sd).toMillis()) % 604800000 == 0)
        : (d == (sd > last ? last : sd) && (frequency != 'yearly' || m == sm));
    }
    function financeSeries(data,uid) {
      return data.keys().hasAll(['kind','description','category','account_id','amount_cents','start_date','end_date','frequency','active','version','created_at','updated_at'])
        && data.keys().hasOnly(['kind','description','category','account_id','amount_cents','start_date','end_date','frequency','active','version','created_at','updated_at'])
        && data.kind in ['income','expense'] && text(data.description,3,160) && category(data.category) && money(data.amount_cents,1) && accountExists(uid,data.account_id)
        && dateString(data.start_date) && (data.end_date == '' || (dateString(data.end_date) && data.end_date >= data.start_date))
        && data.frequency in ['weekly','monthly','yearly'] && data.active is bool;
    }
    match /users/{uid}/accounts/{id} {
      allow read: if own(uid);
      allow create: if own(uid) && financeAccount(request.resource.data) && initial(request.resource.data);
      allow update, delete: if false;
    }
    match /users/{uid}/entries/{id} {
      allow read: if own(uid);
      allow create: if own(uid) && financeEntry(request.resource.data,uid) && initial(request.resource.data)
        && (request.resource.data.series_id == '' || occurrence(request.resource.data,uid,id));
      allow update: if own(uid) && financeEntry(request.resource.data,uid) && nextVersion(request.resource.data,resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','version','updated_at']);
      allow delete: if false;
    }
    match /users/{uid}/series/{id} {
      allow read: if own(uid);
      allow create: if own(uid) && financeSeries(request.resource.data,uid) && initial(request.resource.data);
      allow update: if own(uid) && financeSeries(request.resource.data,uid) && nextVersion(request.resource.data,resource.data);
      allow delete: if false;
    }
    match /users/{uid}/budgets/{id} {
      function budget(data) { return data.keys().hasAll(['month','category','limit_cents','version','created_at','updated_at']) && data.keys().hasOnly(['month','category','limit_cents','version','created_at','updated_at']) && data.month.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$') && category(data.category) && money(data.limit_cents,1) && id == data.month + '_' + data.category; }
      allow read: if own(uid);
      allow create: if own(uid) && budget(request.resource.data) && initial(request.resource.data);
      allow update: if own(uid) && budget(request.resource.data) && nextVersion(request.resource.data,resource.data);
      allow delete: if false;
    }
    match /users/{uid}/goals/{id} {
      function goal(data) { return data.keys().hasAll(['name','target_cents','saved_cents','version','created_at','updated_at']) && data.keys().hasOnly(['name','target_cents','saved_cents','version','created_at','updated_at']) && text(data.name,1,80) && money(data.target_cents,1) && money(data.saved_cents,0) && data.saved_cents <= data.target_cents; }
      allow read: if own(uid);
      allow create: if own(uid) && goal(request.resource.data) && initial(request.resource.data);
      allow update: if own(uid) && goal(request.resource.data) && nextVersion(request.resource.data,resource.data);
      allow delete: if false;
    }
    match /users/{uid}/preferences/interface {
      function preference(data) { return data.keys().hasAll(['theme','widgets']) && data.keys().hasOnly(['theme','widgets']) && data.theme in ['light','dark','system'] && data.widgets is list && data.widgets.size() <= 3 && data.widgets.hasOnly(['chart','alerts','goals']); }
      allow read: if own(uid);
      allow create, update: if own(uid) && preference(request.resource.data);
      allow delete: if false;
    }
    // Compatibility with the existing production collections; originals remain intact.
    function legacy_signedIn() {
      return request.auth != null;
    }

    function legacy_isOwner(uid) {
      return legacy_signedIn() && request.auth.uid == uid;
    }

    function legacy_isAdmin() {
      return admin() || legacy_signedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.admin == true;
    }

    function legacy_authEmail() {
      return request.auth.token.email;
    }

    function legacy_isValidDocumentId(documentId) {
      return documentId is string && documentId.matches('^([0-9]{11}|[0-9]{14})$');
    }

    function legacy_isValidEmail(value) {
      return value is string && value.size() <= 254 && value.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    function legacy_isValidProfileFor(uid) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'NOME_USU',
          'EMAIL_USU',
          'END_USU',
          'CPF_CNPJ_USU',
          'DOCUMENTO_ID',
          'TEL_USU',
          'admin',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.NOME_USU is string
        && request.resource.data.NOME_USU.size() >= 5
        && request.resource.data.NOME_USU.size() <= 120
        && legacy_isValidEmail(request.resource.data.EMAIL_USU)
        && request.resource.data.EMAIL_USU == legacy_authEmail()
        && request.resource.data.END_USU is string
        && request.resource.data.END_USU.size() >= 5
        && request.resource.data.END_USU.size() <= 240
        && request.resource.data.CPF_CNPJ_USU is string
        && request.resource.data.CPF_CNPJ_USU.size() <= 18
        && legacy_isValidDocumentId(request.resource.data.DOCUMENTO_ID)
        && request.resource.data.TEL_USU is string
        && request.resource.data.TEL_USU.matches('^[0-9]{10,11}$')
        && request.resource.data.admin is bool
        && getAfter(/databases/$(database)/documents/documentos/$(request.resource.data.DOCUMENTO_ID)).data.uid == uid;
    }

    function legacy_createdNow() {
      return request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function legacy_validProfileUpdate(uid) {
      return legacy_isValidProfileFor(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.EMAIL_USU == resource.data.EMAIL_USU
        && request.resource.data.admin == resource.data.admin
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    function legacy_validDocumentLockKeys() {
      return request.resource.data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt']);
    }

    function legacy_profileAfterUsesDocument(documentoId) {
      return getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.DOCUMENTO_ID == documentoId;
    }

    function legacy_validDocumentLockCreate(documentoId) {
      return legacy_validDocumentLockKeys()
        && legacy_isValidDocumentId(documentoId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == legacy_authEmail()
        && legacy_profileAfterUsesDocument(documentoId)
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == request.time);
    }

    function legacy_validDocumentLockUpdate(documentoId) {
      return legacy_validDocumentLockKeys()
        && legacy_isValidDocumentId(documentoId)
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == legacy_authEmail()
        && legacy_profileAfterUsesDocument(documentoId)
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == request.time);
    }

    function legacy_validDocumentLockDelete(documentoId) {
      return legacy_isValidDocumentId(documentoId)
        && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.DOCUMENTO_ID != documentoId;
    }

    function legacy_isValidStatus(status) {
      return status in ['Não Visualizado', 'Pendente', 'Em Análise', 'Aprovado', 'Concluído', 'Recusado', 'Cancelado'];
    }

    function legacy_validBudgetCreate() {
      return request.resource.data.keys().hasOnly([
          'NOME_EMPRESA',
          'NOME_CONTATO',
          'EMAIL_CONTATO',
          'TELEFONE_CONTATO',
          'TIPO_SERVICO',
          'DESCRICAO',
          'STATUS_ORCAMENTO',
          'userUid',
          'fk_cod_usuario',
          'COD_ORCAMENTO',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.fk_cod_usuario == request.auth.uid
        && request.resource.data.STATUS_ORCAMENTO == 'Não Visualizado'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.COD_ORCAMENTO is string
        && request.resource.data.COD_ORCAMENTO.matches('^[0-9]{6,12}$')
        && request.resource.data.NOME_CONTATO is string
        && request.resource.data.NOME_CONTATO.size() >= 5
        && request.resource.data.NOME_CONTATO.size() <= 120
        && request.resource.data.NOME_EMPRESA is string
        && request.resource.data.NOME_EMPRESA.size() <= 160
        && legacy_isValidEmail(request.resource.data.EMAIL_CONTATO)
        && request.resource.data.TELEFONE_CONTATO is string
        && request.resource.data.TELEFONE_CONTATO.size() >= 10
        && request.resource.data.TELEFONE_CONTATO.size() <= 18
        && request.resource.data.TIPO_SERVICO is string
        && request.resource.data.TIPO_SERVICO.size() >= 3
        && request.resource.data.TIPO_SERVICO.size() <= 80
        && request.resource.data.DESCRICAO is string
        && request.resource.data.DESCRICAO.size() >= 20
        && request.resource.data.DESCRICAO.size() <= 3000
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function legacy_validBudgetStatusUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['STATUS_ORCAMENTO', 'updatedAt'])
        && legacy_isValidStatus(request.resource.data.STATUS_ORCAMENTO)
        && request.resource.data.updatedAt == request.time;
    }

    match /usuarios/{uid} {
      allow read: if legacy_isOwner(uid) || legacy_isAdmin();
      allow create: if legacy_isOwner(uid)
        && request.resource.data.admin == false
        && legacy_createdNow()
        && legacy_isValidProfileFor(uid);
      allow update: if legacy_isOwner(uid) && legacy_validProfileUpdate(uid);
      allow delete: if false;
    }

    match /documentos/{documentoId} {
      allow get: if legacy_isAdmin() || (legacy_signedIn() && resource.data.uid == request.auth.uid);
      allow list: if false;
      allow create: if legacy_signedIn()
        && !exists(/databases/$(database)/documents/documentos/$(documentoId))
        && legacy_validDocumentLockCreate(documentoId);
      allow update: if legacy_signedIn() && legacy_validDocumentLockUpdate(documentoId);
      allow delete: if legacy_signedIn() && legacy_validDocumentLockDelete(documentoId);
    }

    match /orcamentos/{orcamentoId} {
      allow create: if legacy_signedIn() && legacy_validBudgetCreate();
      allow read: if legacy_isAdmin()
        || (legacy_signedIn() && resource.data.userUid == request.auth.uid);
      allow update: if legacy_isAdmin() && legacy_validBudgetStatusUpdate();
      allow delete: if false;
    }

  }
}
